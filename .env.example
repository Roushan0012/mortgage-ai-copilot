# ==============================================================================
# Darwix AI — AI Copilot for U.S. Mortgage Sales
# Environment Variables Template
#
# IMPORTANT: Copy this file to .env.local for local development.
# Never commit actual API keys or secret credentials to version control.
# ==============================================================================

# Groq API Key for high-performance LLM reasoning & fast contextual inference (Phase 3)
GROQ_API_KEY=

# ElevenLabs API Key for optional text-to-speech voice assistance (Phase 4)
# MUST remain server-side only; never expose as NEXT_PUBLIC_
ELEVENLABS_API_KEY=

# Optional: ElevenLabs Voice and Model configuration overrides
# Default Voice ID: "21m00Tcm4TlvDq8ikWAM" (Rachel - professional mortgage advisory tone)
ELEVENLABS_VOICE_ID=
# Default Model ID: "eleven_turbo_v2_5" (low latency, high-quality audio streaming)
ELEVENLABS_MODEL_ID=

# Optional: Application configuration
NEXT_PUBLIC_APP_NAME="Darwix AI Copilot"
NEXT_PUBLIC_APP_ENV="development"
