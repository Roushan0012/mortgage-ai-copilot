# Groq API Key for high-performance LLM reasoning & fast contextual inference
GROQ_API_KEY=

# ElevenLabs API Key for optional text-to-speech audio guidance & readback
ELEVENLABS_API_KEY=

# Optional: Application configuration
NEXT_PUBLIC_APP_NAME="Darwix AI Copilot"
NEXT_PUBLIC_APP_ENV="development"
